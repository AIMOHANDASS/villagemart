      </div>
    `;
    return await transporter.sendMail({
      from: `"VillageMart" <${process.env.EMAIL_USER}>`,
      to: adminEmail,
      subject: `✅ Dues Collected: ${partnerName} (${partnerRole})`,
      html,
    });
  } catch (err) {
    console.error("❌ Failed to send commission cleared admin email:", err);
  }
}

