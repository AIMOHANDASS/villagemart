/* ================= COMMISSION NOTIFICATIONS ================= */

export async function sendCommissionOverdueMail(to: string, partnerName: string, amountDue: number, paymentLink: string = "") {
  try {
    const actionButtonHtml = paymentLink 
      ? `
        <div style="margin: 24px 0; text-align: center;">
          <a href="${paymentLink}" target="_blank" style="background-color: #dc2626; color: white; padding: 14px 28px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; display: inline-block; box-shadow: 0 4px 6px rgba(220, 38, 38, 0.2);">
            Pay Dues Now
          </a>
        </div>
      `
      : "";

    const html = `
      <div style="font-family:Arial;padding:25px;border:2px solid #fecaca;border-radius:12px;max-width:480px;margin:0 auto;color:#334155;">
        <h2 style="color:#dc2626;margin-top:0;">⚠ Outstanding Commission Due - Account Blocked</h2>
        <p>Dear <strong>${partnerName}</strong>,</p>
        <p>Your account has been temporarily <strong>BLOCKED</strong> because your pending commission balance of <strong style="color:#dc2626;">₹${Number(amountDue).toFixed(2)}</strong> has not been paid before the deadline.</p>
        
        ${actionButtonHtml}
        
        <p style="color:#dc2626;font-weight:bold;text-align:center;">Please clear your outstanding dues immediately using the button above to automatically unblock and restore full access to rides and orders.</p>
        <hr style="border:0;border-top:1px solid #e2e8f0;margin:20px 0;"/>
        <p>Thank you,</p>
        <p><strong>VillageMart Logistics Team</strong></p>
      </div>
    `;
    return await transporter.sendMail({
      from: `"VillageMart" <${process.env.EMAIL_USER}>`,
      to: to || "ram@gmail.com",
      subject: `⚠ URGENT: Outstanding Commission Due (Account Blocked)`,
      html,
    });
  } catch (err) {
    console.error("❌ Failed to send commission overdue email:", err);
  }
}

