        <h2 style="color:#dc2626;margin-top:0;">❌ Profile Suspended Automatically</h2>
        <p>Dear ${partnerName},</p>
        <p>Your VillageMart Partner profile has been automatically suspended due to uncollected application dues of <strong>₹${Number(dueAmount).toFixed(2)}</strong>.</p>
        <p style="font-weight:bold;color:#991b1b;">Your feed access has been locked out. Click the button below to settle dues and instantly restore your account access.</p>
        <div style="margin:25px 0;">
          <a href="${payLink}" style="background-color:#dc2626;color:white;padding:12px 24px;text-decoration:none;border-radius:8px;font-weight:bold;display:inline-block;box-shadow:0 4px 6px -1px rgba(0,0,0,0.15);">Pay Dues & Unblock Profile</a>
        </div>
        <hr style="border:0;border-top:1px solid #fecaca;margin:20px 0;"/>
        <small style="color:#71717a;">VillageMart Security Enforcement</small>
      </div>
    `;
    return await transporter.sendMail({
      from: `"VillageMart Security" <${process.env.EMAIL_USER}>`,
      to,
      subject: `🛑 Account Suspended: VillageMart Partner Dues Overdue`,
      html,
    });
  } catch (err) {
    console.error("❌ Failed to send partner suspension email:", err);
  }
}

