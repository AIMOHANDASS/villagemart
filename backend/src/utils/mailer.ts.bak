export async function sendPartnerDueWarningMail(to: string, partnerName: string, dueAmount: number, partnerId: number, partnerType: string = "delivery") {
  try {
    const payLink = `https://payment.villagemart.in/pay-due?partnerId=${partnerId}&amount=${dueAmount}&partnerType=${partnerType}`;
    const html = `
      <div style="font-family:Arial,sans-serif;padding:25px;border:1px solid #fef08a;border-radius:12px;max-width:600px;background-color:#fffef3;">
        <h2 style="color:#ca8a04;margin-top:0;">⚠️ Urgent Payment Warning</h2>
        <p>Dear ${partnerName},</p>
        <p>Your VillageMart Partner Due of <strong>₹${Number(dueAmount).toFixed(2)}</strong> is expiring in 1 hour.</p>
        <p style="font-weight:bold;color:#b45309;">Please clear it immediately to avoid automatic profile suspension and loss of order feeds.</p>
        <div style="margin:25px 0;">
          <a href="${payLink}" style="background-color:#ca8a04;color:white;padding:12px 24px;text-decoration:none;border-radius:8px;font-weight:bold;display:inline-block;box-shadow:0 4px 6px -1px rgba(0,0,0,0.1);">Pay Due Dues Now</a>
        </div>
        <p>If you have already paid, please ignore this email.</p>
        <hr style="border:0;border-top:1px solid #fef08a;margin:20px 0;"/>
        <small style="color:#71717a;">VillageMart Operations Center</small>
      </div>
    `;
    return await transporter.sendMail({
      from: `"VillageMart Operations" <${process.env.EMAIL_USER}>`,
      to,
      subject: `🚨 Urgent: Your VillageMart Partner Due ₹${Number(dueAmount).toFixed(2)} is expiring soon!`,
      html,
      headers: {
        "X-Priority": "1",
        "X-MSMail-Priority": "High",
        "Importance": "High"
      }
    });
  } catch (err) {
    console.error("❌ Failed to send partner due warning email:", err);
  }
}

